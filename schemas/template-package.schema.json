{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "packageVersion": {
      "type": "string",
      "const": "1"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    },
    "sourceVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\d+\\.\\d+$"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "collection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "displayName"
      ],
      "additionalProperties": false
    },
    "subcollection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "displayName"
      ],
      "additionalProperties": false
    },
    "kind": {
      "type": "string",
      "const": "template"
    },
    "template": {
      "type": "object",
      "properties": {
        "guidance": {
          "type": "string",
          "minLength": 1
        },
        "outline": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "guidance",
        "outline"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "packageVersion",
    "slug",
    "title",
    "summary",
    "sourceVersion",
    "schemaVersion",
    "kind",
    "template"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9_]*[a-z0-9])?$",
          "description": "key must use lowercase letters, digits, and underscores, starting and ending with a letter or digit, e.g. \"acceptance_criteria\" (no hyphens)"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Section title. A repeatable node (cardinality.max null or above 1) needs a {placeholder}, e.g. \"Requirement: {summary}\", so each instance gets its own title."
        },
        "guidance": {
          "type": "string"
        },
        "cardinality": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "key",
        "title",
        "guidance",
        "cardinality",
        "children"
      ],
      "additionalProperties": false
    }
  },
  "dependentRequired": {
    "subcollection": [
      "collection"
    ]
  }
}
