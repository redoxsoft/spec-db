{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "spec",
        "template",
        "pipeline"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "featured": {
      "type": "boolean"
    },
    "templateSlug": {
      "type": "string",
      "minLength": 1
    },
    "relatedSlugs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "icon": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "slug",
    "kind",
    "title",
    "summary",
    "tags",
    "schemaVersion"
  ],
  "additionalProperties": false
}
